# Port the server listens on (with Docker, also the port published on the host)
PORT=3000

# Address the server listens on; 0.0.0.0 means all interfaces
HOST=0.0.0.0

# Directory that holds the SQLite database, relative to the application directory
DATA_DIR=./data

# Set to true only when the application is served over HTTPS
COOKIE_SECURE=false

# Log level: debug | info | warn | error
LOG_LEVEL=info

# Image used by compose.yaml when pulling from a registry (optional)
# KMT_IMAGE=registry.example.lan/kmtracker
# KMT_TAG=latest
